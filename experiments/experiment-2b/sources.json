[
  {
    "source_id":"github_repo_meta",
    "description":"Read public GitHub repository metadata by owner and repo.",
    "method":"GET",
    "url_template":"https://api.github.com/repos/{owner}/{repo}",
    "parameters":["owner","repo"],
    "parameter_modes":{"owner":"component","repo":"component"},
    "exports":{"owner_login":"owner.login","stargazers_count":"stargazers_count"}
  },
  {
    "source_id":"github_repo_from_path",
    "description":"Read public GitHub repository metadata from an owner/repository path produced by earlier steps.",
    "method":"GET",
    "url_template":"https://api.github.com/repos/{repository_path}",
    "parameters":["repository_path"],
    "parameter_modes":{"repository_path":"path"},
    "exports":{"owner_login":"owner.login","stargazers_count":"stargazers_count"}
  },
  {
    "source_id":"github_user_meta",
    "description":"Read public GitHub user metadata.",
    "method":"GET",
    "url_template":"https://api.github.com/users/{username}",
    "parameters":["username"],
    "parameter_modes":{"username":"component"},
    "exports":{"followers":"followers","public_repos":"public_repos"}
  },
  {
    "source_id":"openmeteo_geocode",
    "description":"Resolve a city name to the first public Open-Meteo geocoding result.",
    "method":"GET",
    "url_template":"https://geocoding-api.open-meteo.com/v1/search?name={city}&count=1&language=en&format=json",
    "parameters":["city"],
    "parameter_modes":{"city":"component"},
    "exports":{"latitude":"results.0.latitude","longitude":"results.0.longitude","country_code":"results.0.country_code"}
  },
  {
    "source_id":"openmeteo_current_temperature",
    "description":"Read current temperature in Celsius from Open-Meteo for coordinates.",
    "method":"GET",
    "url_template":"https://api.open-meteo.com/v1/forecast?latitude={latitude}&longitude={longitude}&current=temperature_2m",
    "parameters":["latitude","longitude"],
    "parameter_modes":{"latitude":"component","longitude":"component"},
    "exports":{"temperature_c":"current.temperature_2m"}
  },
  {
    "source_id":"restcountries_alpha",
    "description":"Read public country metadata by ISO alpha-2 code.",
    "method":"GET",
    "url_template":"https://restcountries.com/v3.1/alpha/{country_code}?fields=capitalInfo,currencies,cca2",
    "parameters":["country_code"],
    "parameter_modes":{"country_code":"component"},
    "exports":{"capital_latlng":"capitalInfo.latlng","currencies":"currencies","country_code":"cca2"}
  },
  {
    "source_id":"frankfurter_rate_to_usd",
    "description":"Read the latest USD quote for one base currency from Frankfurter v2.",
    "method":"GET",
    "url_template":"https://api.frankfurter.dev/v2/rate/{base}/USD",
    "parameters":["base"],
    "parameter_modes":{"base":"component"},
    "exports":{"usd_rate":"rate"}
  },
  {
    "source_id":"npm_package_meta",
    "description":"Read public npm registry metadata for one package.",
    "method":"GET",
    "url_template":"https://registry.npmjs.org/{package}",
    "parameters":["package"],
    "parameter_modes":{"package":"component"},
    "exports":{"repository_url":"repository.url","latest_version":"dist-tags.latest"}
  }
]
